# Workiom webhook that receives each waitlist sign-up as JSON
# ({ name, email, phone, country, language }). Server-only: never prefix with NEXT_PUBLIC_.
# Get it from the Workiom automation's webhook trigger. Keep the real value in
# .env.local (gitignored) and in the hosting provider's environment settings.
WORKIOM_WEBHOOK_URL=

# Public site URL, used for canonical links and Open Graph (e.g. https://qareeb.app).
# Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
